# Environment Variables Template — Backend (Copy to .env for local dev)

# ─── Server ───────────────────────────────────────────
NODE_ENV=production
PORT=5001
FRONTEND_URL=https://your-app-name.vercel.app

# ─── Database (Neon PostgreSQL) ───────────────────────
DATABASE_URL="postgresql://username:password@ep-sample-pooler.ap-southeast-2.aws.neon.tech/neondb?sslmode=require"

# ─── JWT Secrets (Generate random 32+ character strings) ───
JWT_ACCESS_SECRET=your_super_secret_access_key_change_in_production_min_32_chars
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_in_production_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Service Modes (set to false when providing real keys) ───
USE_MOCK_AI=true
USE_MOCK_STORAGE=true
USE_MOCK_EMAIL=true
USE_MOCK_OAUTH=true
REQUIRE_EMAIL_VERIFICATION=false

# ─── OpenAI (Required when USE_MOCK_AI=false) ──────────
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4-turbo-preview

# ─── Storage Provider (local, cloudinary, s3) ──────────
STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ─── Email / SMTP (Required when USE_MOCK_EMAIL=false) ────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="AI Interview Coach <noreply@yourdomain.com>"

# ─── Google OAuth (Required when USE_MOCK_OAUTH=false) ───
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://your-backend-name.onrender.com/api/auth/google/callback

# ─── AWS S3 (Required when STORAGE_PROVIDER=s3) ─────────
# AWS_S3_BUCKET=your_bucket_name
# AWS_S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
